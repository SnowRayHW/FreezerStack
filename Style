@import url('https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');

:root {
  /* ---- palette, pulled from the frozen sauce-block photo ---- */
  --frost:     #F3F7F6;
  --frost-dim: #E6EDEC;
  --ink:       #1C2624;
  --ink-soft:  #4B5A57;

  --rust:      #C1552E;
  --olive:     #5B6A3A;
  --oxblood:   #7B2E27;
  --mustard:   #C89A3E;
  --cream:     #DCC79E;

  --line: rgba(28, 38, 36, 0.12);
  --radius: 14px;
  --shadow: 0 1px 2px rgba(28,38,36,0.06), 0 8px 24px rgba(28,38,36,0.06);

  --font-display: 'Anton', 'Arial Narrow', sans-serif;
  --font-body: 'Inter', system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--frost);
  color: var(--ink);
  font-family: var(--font-body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
}

:focus-visible {
  outline: 3px solid var(--rust);
  outline-offset: 2px;
}

.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

/* ---------------- header ---------------- */
header.site-head {
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  background: rgba(243,247,246,0.9);
  backdrop-filter: blur(6px);
  z-index: 20;
}
header.site-head .wrap { display: flex; align-items: center; justify-content: space-between; }
.brand {
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.brand .dot { width: 9px; height: 9px; border-radius: 3px; background: var(--rust); display: inline-block; }
nav.site-nav a {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink-soft);
  text-decoration: none;
  margin-left: 24px;
}
nav.site-nav a:hover { color: var(--ink); }

/* ---------------- hero ---------------- */
.hero { padding: 64px 0 40px; }
.hero .eyebrow {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin: 0 0 10px;
}
.hero h1 {
  font-family: var(--font-display);
  text-transform: uppercase;
  font-size: clamp(40px, 7vw, 76px);
  line-height: 0.95;
  margin: 0 0 18px;
  letter-spacing: 0.01em;
}
.hero h1 span { color: var(--rust); }
.hero p.lede { max-width: 540px; color: var(--ink-soft); font-size: 17px; margin: 0 0 28px; }

.shuffle-btn {
  font-family: var(--font-display);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  font-size: 17px;
  background: var(--ink);
  color: var(--frost);
  border: none;
  padding: 16px 28px;
  border-radius: 10px;
  cursor: pointer;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease, background 0.15s ease;
}
.shuffle-btn:hover { background: var(--rust); }
.shuffle-btn:active { transform: scale(0.97); }
.shuffle-btn.reroll {
  background: transparent;
  color: var(--ink-soft);
  box-shadow: none;
  border: 1px solid var(--line);
  font-family: var(--font-body);
  text-transform: none;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 14px;
  border-radius: 8px;
}
.shuffle-btn.reroll:hover { background: var(--frost-dim); color: var(--ink); }

/* ---------------- block wall (signature element) ---------------- */
.block-wall {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 10px;
  margin-top: 36px;
}
.meal-block {
  position: relative;
  border-radius: 10px;
  padding: 14px 12px 40px;
  min-height: 112px;
  color: #fff;
  cursor: pointer;
  border: none;
  text-align: left;
  font-family: var(--font-body);
  overflow: hidden;
  isolation: isolate;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  box-shadow: var(--shadow);
}
.meal-block::before {
  /* frost overlay, mimics the pale rime on the frozen blocks in the photo */
  content: "";
  position: absolute; inset: 0;
  background:
    radial-gradient(120% 60% at 15% 0%, rgba(255,255,255,0.35), transparent 60%),
    linear-gradient(200deg, rgba(255,255,255,0.12), transparent 40%);
  z-index: -1;
}
.meal-block:hover { transform: translateY(-3px); box-shadow: 0 4px 6px rgba(28,38,36,0.08), 0 16px 28px rgba(28,38,36,0.12); }
.meal-block .day-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.85;
  display: block;
  margin-bottom: 6px;
}
.meal-block .meal-name {
  font-weight: 700;
  font-size: 15px;
  line-height: 1.25;
  display: block;
}
.meal-block .slot-tag {
  position: absolute;
  bottom: 10px; left: 12px;
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  opacity: 0.8;
}
.meal-block .freeze-mark {
  position: absolute;
  top: 10px; right: 10px;
  font-size: 13px;
  opacity: 0.85;
}

.bc-rust { background: var(--rust); }
.bc-olive { background: var(--olive); }
.bc-oxblood { background: var(--oxblood); }
.bc-mustard { background: var(--mustard); color: var(--ink); }
.bc-cream { background: var(--cream); color: var(--ink); }

.week-actions { display: flex; align-items: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; }
.week-empty {
  margin-top: 36px;
  border: 1px dashed var(--line);
  border-radius: var(--radius);
  padding: 40px 24px;
  text-align: center;
  color: var(--ink-soft);
  font-size: 15px;
}

/* ---------------- shopping list ---------------- */
section.shopping {
  padding: 40px 0 60px;
  border-top: 1px solid var(--line);
}
section.shopping h2, section.library h2 {
  font-family: var(--font-display);
  text-transform: uppercase;
  font-size: 28px;
  margin: 0 0 6px;
}
section.shopping .sub, section.library .sub { color: var(--ink-soft); font-size: 14px; margin: 0 0 24px; }
.shopping-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 4px 20px;
}
.shopping-list li {
  border-bottom: 1px solid var(--line);
  padding: 10px 0;
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-size: 14px;
}
.shopping-list li label { display: flex; align-items: baseline; gap: 10px; cursor: pointer; width: 100%; }
.shopping-list li input[type="checkbox"] { accent-color: var(--rust); width: 16px; height: 16px; flex-shrink: 0; }
.shopping-list li.checked label { color: var(--ink-soft); text-decoration: line-through; opacity: 0.6; }
.shopping-list .qty { font-family: var(--font-mono); color: var(--ink-soft); font-size: 12px; margin-left: auto; white-space: nowrap; }

/* ---------------- library ---------------- */
section.library { padding: 20px 0 70px; border-top: 1px solid var(--line); }
.filters { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
.filter-btn {
  font-family: var(--font-mono);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 8px 14px;
  border-radius: 20px;
  border: 1px solid var(--line);
  background: #fff;
  color: var(--ink-soft);
  cursor: pointer;
}
.filter-btn.active { background: var(--ink); color: var(--frost); border-color: var(--ink); }

.recipe-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
}
.recipe-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px;
  cursor: pointer;
  text-align: left;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease;
}
.recipe-card:hover { transform: translateY(-2px); }
.recipe-card .chip {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #fff;
  padding: 3px 8px;
  border-radius: 20px;
  margin-bottom: 10px;
}
.recipe-card h3 { margin: 0 0 6px; font-size: 16px; }
.recipe-card p { margin: 0; font-size: 13px; color: var(--ink-soft); }

/* ---------------- modal ---------------- */
.modal-backdrop {
  position: fixed; inset: 0;
  background: rgba(28,38,36,0.45);
  display: flex; align-items: flex-end;
  justify-content: center;
  z-index: 50;
  padding: 0;
}
@media (min-width: 700px) {
  .modal-backdrop { align-items: center; padding: 24px; }
}
.modal-backdrop.hidden { display: none; }
.modal {
  background: var(--frost);
  width: 100%;
  max-width: 560px;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 18px 18px 0 0;
  padding: 28px;
  position: relative;
}
@media (min-width: 700px) { .modal { border-radius: 18px; } }
.modal .close-btn {
  position: absolute; top: 16px; right: 16px;
  background: none; border: none; font-size: 22px; cursor: pointer; color: var(--ink-soft);
  width: 36px; height: 36px; border-radius: 50%;
}
.modal .close-btn:hover { background: var(--frost-dim); }
.modal .chip { display: inline-block; font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: #fff; padding: 3px 8px; border-radius: 20px; margin-bottom: 12px; }
.modal h2 { font-family: var(--font-display); text-transform: uppercase; font-size: 26px; margin: 0 0 8px; }
.modal .blurb { color: var(--ink-soft); font-size: 14px; margin: 0 0 20px; }
.modal h4 { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-soft); margin: 20px 0 10px; }
.modal ul.ing-list { list-style: none; margin: 0; padding: 0; }
.modal ul.ing-list li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
.modal ul.ing-list li .qty { font-family: var(--font-mono); color: var(--ink-soft); font-size: 12px; }
.modal ol.steps { margin: 0; padding-left: 20px; }
.modal ol.steps li { margin-bottom: 10px; font-size: 14px; }

footer.site-foot {
  border-top: 1px solid var(--line);
  padding: 24px 0 50px;
  color: var(--ink-soft);
  font-size: 13px;
}
